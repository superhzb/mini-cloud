# {{name}} — canonical env (see mini-cloud/docs/env-and-ports.md). Copy to .env.
# `mini new` generates a real .env for you; this is the committed reference.

APP_NAME={{name}}
APP_ENV=dev
PORT={{api_port}}
LOG_LEVEL=info

# database (mini_cloud.db)
DATABASE_URL=postgresql://{{name}}:CHANGE_ME@127.0.0.1:15432/{{name}}

# object storage (mini_cloud.storage)
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_dev_change_me
STORAGE_BUCKET={{name}}
STORAGE_REGION=us-east-1

# observability (mini_cloud.obs)
LOKI_URL=http://127.0.0.1:13100

# inference (mini_cloud.inference) — optional; falls back to a trivial summary without it
MINI_INFERENCE_URL=http://127.0.0.1:19207/v1
# INFERENCE_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
