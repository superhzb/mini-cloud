        {
          "refId": "A",
          "expr": "sum by (queue, outcome) (rate(queue_jobs_processed_total{job=\"ref-showcase\"}[5m]))",
          "legendFormat": "{{queue}} · {{outcome}}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
