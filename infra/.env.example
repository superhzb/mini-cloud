# mini-cloud infra — copy to .env and fill in. NEVER commit .env (see .gitignore).
# Loopback-only defaults below are safe for single-machine dev as-is.

# --- Bind interface -----------------------------------------------------------------
# 127.0.0.1 = loopback only (default, safe). Moving this to a specific interface IP
# (e.g. a tailnet address) widens the trust boundary and makes the credentials below
# MANDATORY and strong. NEVER use 0.0.0.0. See docs → Multi-machine development.
INFRA_BIND_ADDR=127.0.0.1

# --- Unified dev admin login --------------------------------------------------------
# One account for every service: user `admin` / password `adminlocal`.
# Grafana, MinIO, Postgres, and Adminer all accept it (a fresh volume bootstraps
# Postgres directly as the `admin` superuser). Dev-only; rotate before VPS graduation.

# --- Postgres -----------------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=adminlocal
POSTGRES_DB=postgres
# Auth is scram-sha-256 regardless. On a non-loopback bind, replace the password above
# with a strong secret before starting.

# --- Adminer (DB browser, dev only) -------------------------------------------------
# Adminer auto-logs-in with POSTGRES_USER/POSTGRES_PASSWORD above (loopback only). Optionally
# land directly in one database instead of the DB picker (e.g. ref-showcase). Blank = picker.
ADMINER_DEFAULT_DB=

# --- MinIO (S3) ---------------------------------------------------------------------
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=adminlocal
# On a non-loopback bind, replace both with real random access keys.

# --- Grafana ------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=adminlocal
GRAFANA_ANONYMOUS=false

# --- mini-cloud-identity (the auth SERVICE; apps set MINI_AUTH_* instead) ------------
# Secrets live here, on the box that runs the identity service — never in an app. An app is a
# verifier: it only ever sets MINI_AUTH_ISSUER/_JWKS_URL/_AUDIENCE (see docs/env-and-ports.md).
#
# Zero-setup local dev: with none of these set the service still boots on an EPHEMERAL signing key
# + in-memory store, and dev login (admin/admin) is on. For a store that survives a restart, run
# `make identity-init` and set IDENTITY_DATABASE_URL (printed by that script). Password `identity`
# below matches its default owner role.
# IDENTITY_DATABASE_URL=postgresql://identity:identity@127.0.0.1:15432/identity

# Stable signing key (mount, don't commit). Absent → ephemeral ES256 minted at boot (dev only).
# Generate:  openssl ecparam -genkey -name prime256v1 -noout | openssl pkcs8 -topk8 -nocrypt
# MINI_AUTH_SIGNING_KEY_FILE=/run/secrets/identity-signing-key.pem
# MINI_AUTH_KID=mini-auth-1

# Google OAuth client (absent → /login 503s, but the dev grant still works). Create at
# https://console.cloud.google.com/apis/credentials with redirect ${MINI_AUTH_ISSUER}/callback.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Dev password grant. ON by default locally; the service REFUSES TO BOOT with it enabled on a
# non-local deployment (non-loopback MINI_AUTH_ISSUER or APP_ENV!=dev). Set 0 on graduation.
# MINI_AUTH_DEV_LOGIN=0
