# ref-showcase — copy to .env and adjust. Canonical names only (see docs/env-and-ports.md).
# These loopback defaults match a local `mini-cloud/infra` stack + a `ref-showcase` DB/bucket
# created with `make -C ../../infra project NAME=ref-showcase`.

APP_NAME=ref-showcase
APP_ENV=dev
PORT=19208
LOG_LEVEL=info

# --- database (mini_cloud.db) --------------------------------------------------------
DATABASE_URL=postgresql://ref-showcase:ref-showcase@127.0.0.1:15432/ref-showcase

# --- object storage (mini_cloud.storage) ---------------------------------------------
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_dev_change_me
STORAGE_BUCKET=ref-showcase
STORAGE_REGION=us-east-1

# --- observability (mini_cloud.obs) --------------------------------------------------
LOKI_URL=http://127.0.0.1:13100

# --- inference (mini_cloud.inference) ------------------------------------------------
# Live-required for the AI tours (embed/search/summary/chat). Without it, the pipeline falls
# back to a deterministic offline embedding + first-line summary so the app still runs.
MINI_INFERENCE_URL=http://127.0.0.1:19207/v1
# MINI_INFERENCE_PROJECT identifies this app to the multi-tenant gateway (X-MLX-Project header).
# Optional: the SDK defaults it to APP_NAME, so ref-showcase is already identified as "ref-showcase".
# MINI_INFERENCE_PROJECT=ref-showcase
# INFERENCE_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
# INFERENCE_EMBED_MODEL=mlx-community/nomic-embed-text-v1.5

# --- product analytics (mini_cloud.analytics) ----------------------------------------
# The shared `analytics` event store — a SEPARATE database from DATABASE_URL, on the same :15432,
# with its own writer role. Create it with `make -C ../../infra analytics-init` (DB + read-only
# Grafana role + schema). Optional: without it, the app runs and the /analytics/* tour reports 503.
MINI_ANALYTICS_DSN=postgresql://analytics:analytics@127.0.0.1:15432/analytics
# MINI_ANALYTICS_BACKEND=postgres        # postgres (default) | posthog (graduation seam, stubbed)
# MINI_ANALYTICS_PROJECT=ref-showcase    # defaults to APP_NAME
