# ref-fastapi — copy to .env and adjust. Canonical names only (see docs/env-and-ports.md).
# These loopback defaults match a local `mini-cloud/infra` stack + a `ref-fastapi` DB/bucket
# created with `make -C ../../infra project NAME=ref-fastapi`.

APP_NAME=ref-fastapi
APP_ENV=dev
PORT=19204
LOG_LEVEL=info

# --- database (mini_cloud.db) --------------------------------------------------------
DATABASE_URL=postgresql://ref-fastapi:ref-fastapi@127.0.0.1:15432/ref-fastapi

# --- object storage (mini_cloud.storage) ---------------------------------------------
STORAGE_ENDPOINT=http://127.0.0.1:19000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin_dev_change_me
STORAGE_BUCKET=ref-fastapi
STORAGE_REGION=us-east-1

# --- observability (mini_cloud.obs) --------------------------------------------------
LOKI_URL=http://127.0.0.1:13100

# --- inference (mini_cloud.inference) ------------------------------------------------
# Optional: without it, the summarizer falls back to a trivial first-line summary.
MINI_INFERENCE_URL=http://127.0.0.1:19207/v1
# INFERENCE_MODEL=mlx-community/Qwen2.5-7B-Instruct-4bit
