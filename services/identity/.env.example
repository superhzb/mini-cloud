# mini-cloud-identity service configuration. Copy to `.env`; `.env` is gitignored.
APP_NAME=mini-cloud-identity
APP_ENV=dev
PORT=19210
MINI_AUTH_ISSUER=http://127.0.0.1:19210
MINI_AUTH_AUDIENCE=mini-cloud

# Persistent authorization store. Change the password with IDENTITY_PASSWORD when provisioning.
IDENTITY_DATABASE_URL=postgresql://identity:identity@127.0.0.1:15432/identity

# Stable ES256/RS256 signing key. Prefer the file form; never commit the private key.
MINI_AUTH_SIGNING_KEY_FILE=.identity-signing-key.pem
MINI_AUTH_KID=mini-auth-1
MINI_AUTH_ALGORITHM=ES256
MINI_AUTH_ACCESS_TTL=900

# Basic username/password login. admin/admin is the default local developer super-admin.
# The endpoint accepts only loopback/private-IP/mDNS Host headers, never the public OAuth host.
MINI_AUTH_PASSWORD_LOGIN=1
MINI_AUTH_ADMIN_USER=admin
MINI_AUTH_ADMIN_PASSWORD=admin

# Google OAuth. Copy the client values from the existing srt-flow auth environment.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:19210/callback

# Optional browser destination after Google login; the token is returned in the URL fragment.
MINI_AUTH_POST_LOGIN_REDIRECT=
MINI_AUTH_STATE_SECRET=

LOG_LEVEL=info
